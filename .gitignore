# 🐍 PYTHON
# ----------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.sqlite3

# ----------------------
# 🧪 VIRTUAL ENV
# ----------------------
.venv/
venv/
env/

# ----------------------
# 📦 DATA FILES (LARGE / GENERATED)
# ----------------------
data/chunks/
data/extracted/
data/*.pkl
data/*.json
# ...except the evaluation question set, which is source, not output (P5).
!data/test_set.json

# Runtime SQLite feedback store: written on every query, never committed.
data/feedback.db
*.db

# ----------------------
# 🧠 VECTOR DB (IMPORTANT)
# ----------------------
chroma_db/
*.bin

# ----------------------
# 📊 LOGS
# ----------------------
logs/
*.log

