# Copy to .env (never commit .env). Only the key is required.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Gemini calls allowed per rolling minute (free-tier friendly). Default 10.
GEMINI_MAX_CALLS_PER_MIN=10

# 1 = run the YES/NO sufficiency check before generating (extra Gemini call).
# 0 = skip it. Decide from the P5 evaluation numbers.
ATHER_SUFFICIENCY_CHECK=1
